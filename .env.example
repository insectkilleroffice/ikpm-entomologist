# Same Supabase project as ikpm-admin and ikpm-operation.
# Only the public URL and the publishable (anon) key are used. The service role key
# is never needed by this portal — do not add it here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable key>
